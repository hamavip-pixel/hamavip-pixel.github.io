            let savedKey = localStorage.getItem("hx_active_key");
            if (savedKey) {
                document.getElementById("auth-box").style.display = "none";
                document.getElementById("pro-content").style.display = "block";
            }
        }

        function checkKey() {
            let userKey = document.getElementById("access-key").value.trim();
            let errorMsg = document.getElementById("error");

            let usedKeys = JSON.parse(localStorage.getItem("hx_used_keys") || "[]");

            if (validKeys.hasOwnProperty(userKey)) {
                if (usedKeys.includes(userKey)) {
